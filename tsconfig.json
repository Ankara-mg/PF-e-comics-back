{
  "compilerOptions": {
    "target": "es6",
    "module": "nodenext",
    "allowJs": true,
    "outDir": "./build",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "baseUrl": "./",
    "paths": {
      "@custom-types/*": [
        "src/types/*"
      ],
    }
  },
  "exclude": [
    "node_modules"
  ]
}